function docreate () {⎩1⎭
      defsynonym parameterAddress ≡ λlen (State.RAM) + 4⎩2⎭
      %push (parameterAddress)⎩3⎭
  } ⎩4⎭
function create (name) {⎩5⎭ ⎩6⎭
      λcode (name, normal, ↪︎docreate)⎩7⎭
  } ⎩8⎭
⎩9⎭
subr drop {⎩10⎭
      ⌈ ( a -- ) ⌉⎩11⎭
      %pop⎩12⎭
  } ⎩13⎭
⎩14⎭
initialize {⎩15⎭
  λok ()⎩16⎭
}⎩17⎭