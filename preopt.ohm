
pretransmogrifier {
  code = item+
  item =
    | applySyntactic<Scope> -- scope
    | any -- other

  Scope =
    | "subr" id  block -- subrblock
    | "function" id "(" argchar* ")" block -- funcblock

  block = "{" blockInnards+ "}"
  blockInnards =
    | "{" blockInnards+ "}" blockInnards?    -- rec
    | applySyntactic<Pattern> blockInnards? -- pattern
    | (~"}" ~"{" ~applySyntactic<Pattern> any)+ blockInnards?             -- other

  Pattern =
    | "defsynonym" id "≡" SimplePureExpression -- memomacro
    
  bodyCh =
    | "{" bodyCh+ "}" -- recursive
    | ~"{" ~"}" item     -- flat

  SimplePureExpression =
    | "(" SimplePureExpression ")" -- parenthesized
    | int -- int
  
  int = "-"? digit+
  id = (letter | "_") (alnum | "_")*
  
  argchar = 
    | "(" argchar* ")" argchar? -- rec
    | (~"(" ~")" any)+ -- other
}
