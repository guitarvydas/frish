% rewrite pretransmogrifier {
  code [item+] = ‛«item»’
  item_scope [s] = ‛«s»’
  item_other [c] = ‛«c»’

  Scope_functionblock [_func name lb formals* rb block] =       ‛\nfunction «name» («formals») «block»’
  Scope_subrblock [_subr name block] = ‛\nsubr «name» «block»’

  Block [lb innards rb] = 
    ⎡ ⎨pushnewmacroscope⎬
      ‛{«innards»} ⎨popmacroscope⎬’
    ⎦

  blockInnards_rec [lb innards rb more?] = ‛{«innards»}«more»’
  blockInnards_pattern [p more?] = ‛«p»«more»’
  blockInnards_other [cs+ more?] = ‛«cs»«more»’
  
  Pattern_memomacro [_defsyn name _def e] =
    ⎡ ⎨memomacro ‛«name»’ ‛«e»’⎬
      ‛ ⎨xcontinue⎬’
    ⎦
  Pattern_name [name] = ‛⎨macrolookup ‛«name»’⎬’
  
  exprCh [c] = ‛«c»’
  bodyCh_recursive [_lb cs+ _rb] = ‛«_lb»«cs»«_rb»’
  bodyCh_flat [c] =‛«c»’

  PureExpression_parenthesized [lp e rp] = ‛(«e»)’
  PureExpression_item [i] = ‛«i»’
  
  PureExpressionItem_indexed [p lb e rb] = ‛«p»[«e»]’
  PureExpressionItem_op [prim op e] = ‛(«prim» «op» «e»)’
  PureExpressionItem_primary [prim] = ‛(«prim»)’

  primary [p] = ‛«p»’
  op [x] = ‛ «x»’
  int [sign? ds+] = ‛ «sign»«ds»’
  id [c cs*] = ‛«c»«cs»’
  str [lq cs* rq] = ‛"«cs»"’
  Call [_call args] = ‛«_call» «args»’
  Args [lp innards? rp] = ‛(«innards»)’
  ArgInnards_rec [lp innards? rp] = ‛(«innards»)’
  ArgInnards_other [cs+] =‛«cs»’
}
