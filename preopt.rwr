% rewrite pretransmogrifier {
  code [item+] = ‛«item»’
  item_scope [s] = ‛«s»’
  item_other [c] = ‛«c»’

  Scope_subrblock [_subr name block] = ‛\nsubr «name» «block»’
  Scope_funcblock [_func name lp argchar* rp block] = ‛\nfunction «name» («argchar») «block»’

  block [lb innards+ rb] = 
    ⎡ ⎨pushnewmacroscope⎬
      ‛{«innards»} ⎨popmacroscope⎬’
    ⎦

  blockInnards_rec [lb innards+ rb more?] = ‛{«innards»}«more»’
  blockInnards_pattern [p more?] = ‛«p»«more»’
  blockInnards_other [cs+ more?] = ‛«cs»«more»’
  
  Pattern_memomacro [_defsyn name _def e] =
    ⎡ ⎨memomacro ‛«name»’ ‛«e»’⎬
      ‛ ⎨xcontinue⎬’
    ⎦
  
  bodyCh_recursive [_lb cs+ _rb] = ‛«_lb»«cs»«_rb»’
  bodyCh_flat [c] =‛«c»’

  SimplePureExpression_parenthesized [lp e rp] = ‛(«e»)’
  SimplePureExpression_int [i] = ‛ «i»’
  
  int [sign? ds+] = ‛ «sign»«ds»’
  id [c cs*] = ‛«c»«cs»’

  argchar_rec [lp cs* rp more?] = ‛(«cs»)«more»’
  argchar_other [c] = ‛«c»’
}
