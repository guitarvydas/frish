
  function create () {
      defsynonym xxx ≡ 0
      λcode (xxx)
  }

  subr drop {
      ⌈ ( a -- ) ⌉
      %pop
  }

  function doconst () {  ⌈ method for const ⌉
      defsynonym parameter ≡ State.RAM [State.W + 1]
      %push (parameter)
  }


  function docreate () {
      defsynonym parameterAddress ≡ %funcall len (State.RAM) + 4
      %push (parameterAddress)
  }

initialize {
  λok ()
}
